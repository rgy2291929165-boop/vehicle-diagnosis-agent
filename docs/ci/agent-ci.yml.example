name: Agent CI

on:
  push:
  pull_request:
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: agent-ci-${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

jobs:
  agent:
    runs-on: ubuntu-24.04
    timeout-minutes: 20
    env:
      PYTHONDONTWRITEBYTECODE: "1"
      PYTEST_DISABLE_PLUGIN_AUTOLOAD: "1"
      HF_HUB_OFFLINE: "1"
      TRANSFORMERS_OFFLINE: "1"
      AGENT_PORT: "18002"
      COMPOSE_PROJECT_NAME: agent-ci-${{ github.run_id }}-${{ github.run_attempt }}
    steps:
      - uses: actions/checkout@d23441a48e516b6c34aea4fa41551a30e30af803 # v6
      - uses: actions/setup-python@ece7cb06caefa5fff74198d8649806c4678c61a1 # v6
        with:
          python-version: "3.11"
      - name: Install locked Agent runtime and test dependencies
        run: |
          python -m pip install -r requirements-ci.txt
          python -m pip check
      - name: Agent tests and 20 workflow cases
        run: python scripts/run_agent_ci.py --output-dir evaluation/week4/ci-runs/github
      - name: Validate Compose and build image
        run: |
          docker compose config --quiet
          docker compose build
      - name: Start healthy container and check HTTP with MCP
        run: |
          docker compose up -d --wait --wait-timeout 90
          python scripts/check_agent_http.py --base-url http://127.0.0.1:18002
          docker compose exec -T agent python -m pip check
      - name: Container logs and cleanup
        if: always()
        run: |
          docker compose logs --no-color --tail=100
          docker compose down
      - name: Upload test evidence
        if: always()
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4
        with:
          name: agent-ci-${{ github.run_id }}-${{ github.run_attempt }}
          path: evaluation/week4/ci-runs/github/
          if-no-files-found: warn
          retention-days: 7
